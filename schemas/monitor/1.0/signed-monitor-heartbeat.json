{
  "$defs": {
    "ComponentIdentity": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Component Id",
          "type": "string"
        },
        "generation": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Generation",
          "type": "string"
        },
        "instance_uid": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Instance Uid",
          "type": "string"
        },
        "role": {
          "enum": [
            "agent",
            "boundary"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "0.2",
          "default": "0.2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "role",
        "instance_uid",
        "generation"
      ],
      "title": "ComponentIdentity",
      "type": "object"
    },
    "LeaseBinding": {
      "additionalProperties": false,
      "description": "Trusted provisioning context, never learned from a returned receipt.",
      "properties": {
        "attempt_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "binding_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Binding Digest",
          "type": "string"
        },
        "cell_uid": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Cell Uid",
          "type": "string"
        },
        "component": {
          "$ref": "#/$defs/ComponentIdentity"
        },
        "effective_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Effective Policy Digest",
          "type": "string"
        },
        "lease_expires_at": {
          "format": "date-time",
          "title": "Lease Expires At",
          "type": "string"
        },
        "lease_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Lease Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "binding_digest",
        "run_id",
        "attempt_id",
        "lease_id",
        "cell_uid",
        "component",
        "effective_policy_digest",
        "lease_expires_at"
      ],
      "title": "LeaseBinding",
      "type": "object"
    },
    "MonitorHeartbeat": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "generation": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Generation",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/MonitorRequest"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "title": "Sequence",
          "type": "integer"
        },
        "signer_identity": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Signer Identity",
          "type": "string"
        },
        "state": {
          "enum": [
            "healthy",
            "lost",
            "incident"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "request",
        "signer_identity",
        "generation",
        "sequence",
        "state",
        "issued_at",
        "expires_at"
      ],
      "title": "MonitorHeartbeat",
      "type": "object"
    },
    "MonitorRequest": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/LeaseBinding"
        },
        "challenge": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Challenge",
          "type": "string"
        },
        "purpose": {
          "const": "containment-monitor",
          "default": "containment-monitor",
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "challenge",
        "binding"
      ],
      "title": "MonitorRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "Ed25519",
      "default": "Ed25519",
      "title": "Algorithm",
      "type": "string"
    },
    "heartbeat": {
      "$ref": "#/$defs/MonitorHeartbeat"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "pattern": "^[0-9a-f]{128}$",
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "heartbeat",
    "signature"
  ],
  "title": "SignedMonitorHeartbeat",
  "type": "object"
}
