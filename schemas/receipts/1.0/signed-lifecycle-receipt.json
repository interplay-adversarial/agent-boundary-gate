{
  "$defs": {
    "CleanupClaim": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "const": "whole-cell",
          "title": "Scope",
          "type": "string"
        },
        "state": {
          "const": "destroyed",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "scope"
      ],
      "title": "CleanupClaim",
      "type": "object"
    },
    "ComponentIdentity": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Component Id",
          "type": "string"
        },
        "generation": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Generation",
          "type": "string"
        },
        "instance_uid": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Instance Uid",
          "type": "string"
        },
        "role": {
          "enum": [
            "agent",
            "boundary"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "0.2",
          "default": "0.2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "role",
        "instance_uid",
        "generation"
      ],
      "title": "ComponentIdentity",
      "type": "object"
    },
    "LeaseBinding": {
      "additionalProperties": false,
      "description": "Trusted provisioning context, never learned from a returned receipt.",
      "properties": {
        "attempt_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "binding_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Binding Digest",
          "type": "string"
        },
        "cell_uid": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Cell Uid",
          "type": "string"
        },
        "component": {
          "$ref": "#/$defs/ComponentIdentity"
        },
        "effective_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Effective Policy Digest",
          "type": "string"
        },
        "lease_expires_at": {
          "format": "date-time",
          "title": "Lease Expires At",
          "type": "string"
        },
        "lease_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Lease Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "binding_digest",
        "run_id",
        "attempt_id",
        "lease_id",
        "cell_uid",
        "component",
        "effective_policy_digest",
        "lease_expires_at"
      ],
      "title": "LeaseBinding",
      "type": "object"
    },
    "LifecycleReceipt": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "discriminator": {
            "mapping": {
              "destroyed": "#/$defs/CleanupClaim",
              "ready": "#/$defs/ReadinessClaim"
            },
            "propertyName": "state"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ReadinessClaim"
            },
            {
              "$ref": "#/$defs/CleanupClaim"
            }
          ],
          "title": "Claim"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ReceiptRequest"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "signer_identity": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Signer Identity",
          "type": "string"
        }
      },
      "required": [
        "signer_identity",
        "request",
        "issued_at",
        "expires_at",
        "claim"
      ],
      "title": "LifecycleReceipt",
      "type": "object"
    },
    "ReadinessClaim": {
      "additionalProperties": false,
      "properties": {
        "effective_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Effective Policy Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "const": "ready",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "effective_policy_digest"
      ],
      "title": "ReadinessClaim",
      "type": "object"
    },
    "ReceiptRequest": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/LeaseBinding"
        },
        "challenge": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Challenge",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "readiness",
            "cleanup"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "challenge",
        "binding"
      ],
      "title": "ReceiptRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "Ed25519",
      "default": "Ed25519",
      "title": "Algorithm",
      "type": "string"
    },
    "receipt": {
      "$ref": "#/$defs/LifecycleReceipt"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "pattern": "^[0-9a-f]{128}$",
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "receipt",
    "signature"
  ],
  "title": "SignedLifecycleReceipt",
  "type": "object"
}
