{
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "attempt_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "target_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Digest",
          "type": "string"
        },
        "suite_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Suite Digest",
          "type": "string"
        },
        "topology_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Topology Digest",
          "type": "string"
        },
        "boundary_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Boundary Policy Digest",
          "type": "string"
        },
        "effective_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Effective Policy Digest",
          "type": "string"
        },
        "gate_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Gate Policy Digest",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "target_digest",
        "suite_digest",
        "topology_digest",
        "boundary_policy_digest",
        "effective_policy_digest",
        "gate_policy_digest"
      ],
      "title": "Binding",
      "type": "object"
    },
    "Decision": {
      "enum": [
        "pass",
        "criteria_failed",
        "inconclusive",
        "incident"
      ],
      "title": "Decision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/Binding"
    },
    "dispatch_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Dispatch Digest",
      "type": "string"
    },
    "release_decision": {
      "$ref": "#/$defs/Decision"
    },
    "release_eligible": {
      "const": false,
      "default": false,
      "title": "Release Eligible",
      "type": "boolean"
    },
    "qualification": {
      "const": "m0-prototype",
      "default": "m0-prototype",
      "title": "Qualification",
      "type": "string"
    },
    "decision_reasons": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
        "type": "string"
      },
      "title": "Decision Reasons",
      "type": "array"
    },
    "raw_aggregate": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Aggregate"
    },
    "confirmed_violations": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
        "type": "string"
      },
      "title": "Confirmed Violations",
      "type": "array"
    },
    "waived_vetoes": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
        "type": "string"
      },
      "title": "Waived Vetoes",
      "type": "array"
    },
    "degraded_diagnostics": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
        "type": "string"
      },
      "title": "Degraded Diagnostics",
      "type": "array"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    }
  },
  "required": [
    "binding",
    "dispatch_digest",
    "release_decision",
    "decision_reasons",
    "raw_aggregate",
    "confirmed_violations",
    "waived_vetoes",
    "degraded_diagnostics",
    "evaluated_at"
  ],
  "title": "GateDecision",
  "type": "object"
}
