{
  "protocol": "agent-boundary-gate/http-probe/1.0",
  "status": "experimental-dns",
  "arguments": ["host", "port", "attempt", "timeout-seconds"],
  "address_families": ["IPv4", "IPv6"],
  "dns": true,
  "method": "GET",
  "path": "/probe",
  "headers": ["Host", "X-Gate-Attempt", "Connection"],
  "connection": "close",
  "max_response_bytes": 1,
  "max_attempt_bytes": 128,
  "timeout_seconds": {"minimum": 1, "maximum": 30},
  "completion_prefix": "agent-boundary-gate-probe-complete:",
  "invalid_input": {"exit_code": 2, "stderr": "invalid-probe-input\n"},
  "runtime_failure": {"exit_code": 2, "stderr": "probe-runtime-failed\n"},
  "network_rejection_or_timeout_completes_attempt": true,
  "completion_is_outcome_proof": false,
  "release_eligible": false
}
